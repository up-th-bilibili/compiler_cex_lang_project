#pragma once
class optional<T>{
    __slots__{
        bool has_value;
        T value;
    }
    optional<T>* __new__(cls,bool has_value,...){
        optional<T>* self;
        if(has_value)self = malloc(sizeof(optional<T>));
        else self = malloc(sizeof(bool));
        return self;
    }
    void __init__(self,bool has_value,T value){
        if(self===nullptr)return;
        self->has_value = has_value;
        if(has_value)self->value = value;
    }
    void __init__(self,bool has_value,T* value){
        if(self===nullptr)return;
        self->has_value = has_value;
        if(has_value)memcpy(&(self->value),value,sizeof(T));
    }
    T get_value(self){
        return self->value;
    }
    _Operator bool eq(self,optional<T>* other){
        if(!((self->has_value)||(other->has_value)))return true;
        if(!((self->has_value)&&(other->has_value)))return false;
        return self->value == other->value;
    }
    _Operator bool eq(self,T other){
        if(!self->has_value)return false;
        return self->value == other;
    }
    _Operator bool eq(self,...){
        return false;
    }
}
